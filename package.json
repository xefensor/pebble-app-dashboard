{
  "name": "pebble-app-dashboard",
  "version": "0.6.3",
  "author": "Xef",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "A stock Pebble Dashboard for activities, notifications and mixed pinned readings/actions.",
  "dependencies": {
    "pebble-activities": "file:vendor/pebble-activities-0.4.4.tgz",
    "pebble-xoce-ui": "file:vendor/pebble-xoce-ui-0.1.1.tgz"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && python3 scripts/test-native.py && npm run test:workflow && npm run check:docs && npm run test:release",
    "build": "python3 scripts/build.py",
    "check:artifact": "python3 scripts/check-artifact.py",
    "build:release": "python3 scripts/build.py --release",
    "test:workflow": "python3 -m unittest discover -s tests -p test_development_workflow.py",
    "test:source": "node --test tests/*.test.js && python3 scripts/test-native.py",
    "check:config": "node scripts/generate-config.cjs --check",
    "release:source": "python3 scripts/package-source.py",
    "check:docs": "python3 scripts/check-docs.py",
    "release:prepare": "python3 scripts/github-release.py prepare",
    "release:publish": "python3 scripts/github-release.py publish",
    "test:release": "python3 -m unittest discover -s tests -p \"test_*release*.py\"",
    "check:setup": "python3 scripts/check-setup.py"
  },
  "pebble": {
    "displayName": "Dashboard",
    "uuid": "f76f9fc1-2944-4248-bcc5-3eea2af0183b",
    "sdkVersion": "3",
    "projectType": "native",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "configPage": "config.html",
    "usesPermissions": [
      "Location",
      "ReadMusic",
      "ControlMusic",
      "Notifications",
      "FindMyPhone",
      "LaunchApps",
      "ReadWatchSettings",
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "gm3s9tryo4-dsn.algolia.net"
          ]
        }
      }
    ],
    "plugin": {
      "description": "Dashboard preferences and plugin catalogue settings. No activity source or action proxy.",
      "script": "plugin.js",
      "sources": [],
      "actions": []
    },
