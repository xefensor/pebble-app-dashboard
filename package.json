{
  "name": "pebble-app-dashboard",
  "version": "0.2.0",
  "author": "Xef",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "A stock Pebble Dashboard for activities, notifications and mixed pinned readings/actions.",
  "dependencies": {
    "pebble-activities": "file:vendor/pebble-activities-0.4.2.tgz"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && python3 scripts/test-native.py",
    "build": "python3 scripts/build.py",
    "check:artifact": "python3 scripts/check-artifact.py"
  },
  "pebble": {
    "displayName": "Dashboard",
    "uuid": "f76f9fc1-2944-4248-bcc5-3eea2af0183b",
    "sdkVersion": "3",
    "projectType": "native",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "configPage": "config.html",
    "usesPermissions": [
      "Location",
      "ReadMusic",
      "ControlMusic",
      "Notifications",
      "FindMyPhone",
      "LaunchApps",
      "ReadWatchSettings"
    ],
    "plugin": {
      "description": "Dashboard preferences and plugin catalogue settings. No activity source or action proxy.",
      "script": "plugin.js",
      "sources": [],
      "actions": []
    },
